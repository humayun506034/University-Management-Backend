generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String    @unique
  role                     UserRole  @default(STUDENT)
  image                    String?
  studentId                String?   @unique
  employeeId               String?   @unique
  designation              String?
  departmentId             String?
  phoneNumber              String?
  password                 String
  registrationOtp          String?
  registrationOtpExpireIn  DateTime?
  loginOtp                 String?
  loginOtpExpireIn         DateTime?
  resetPasswordOtp         String?
  resetPasswordOtpExpireIn DateTime?
  lastPasswordChangeTime   DateTime?
  loginTime                DateTime?
  registrationTime         DateTime?
  isVerified               Boolean   @default(false)
  isBlocked                Boolean   @default(false)
  isDeleted                Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // 🔁 Relations
  sentMessages     Message[]   @relation("SenderMessages")
  receivedMessages Message[]   @relation("ReceiverMessages")
  department       Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHead")
}

model Message {
  id             String   @id @default(uuid())
  senderEmail    String
  recipientEmail String
  text           String?
  document       String?
  createdAt      DateTime @default(now())

  Sender   User @relation("SenderMessages", fields: [senderEmail], references: [email])
  Receiver User @relation("ReceiverMessages", fields: [recipientEmail], references: [email])
}

model Department {
  id               String           @id @default(uuid())
  name             String           @unique
  status           DepartmentStatus @default(ACTIVE)
  departmentHeadId String?          @unique
  isDeleted        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members        User[] @relation("DepartmentMembers")
  departmentHead User?  @relation("DepartmentHead", fields: [departmentHeadId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  REGISTRAR
  DEPARTMENT_HEAD
  FACULTY
  STUDENT
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}
